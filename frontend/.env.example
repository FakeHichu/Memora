EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Backend URL configuration:
# - For web development: http://localhost:4000
# - For Android Studio emulator: http://10.0.2.2:4000
# - For physical Android device: http://YOUR_COMPUTER_IP:4000 (e.g., http://192.168.1.100:4000)
# - For iOS simulator: http://localhost:4000
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000
EXPO_PUBLIC_APP_NAME=Memora
EXPO_PUBLIC_APP_SCHEME=memora