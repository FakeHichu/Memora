{
  "expo": {
    "name": "Memora",
    "slug": "memora",
    "scheme": "memora",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memora to use the camera for capturing daily memories."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Memora to access your photo library to select memories.",
          "cameraPermission": "Allow Memora to use your camera to capture memories."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memora.classmemories",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Memora to use the camera for capturing daily memories.",
        "NSPhotoLibraryUsageDescription": "Allow Memora to access your photo library to select memories."
      }
    },
    "android": {
      "package": "com.memora.classmemories",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0813",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://rynpdrprbesctvwcrjii.supabase.co",
      "supabaseAnonKey": "sb_publishable_2MQ-po4yVwoVxEOu4GYYpw_zG_uvEYD",
      "backendUrl": "http://localhost:4000",
      "appName": "Memora",
      "router": {},
      "eas": {
        "projectId": "eb865880-9106-4970-b163-8d962c0a8b1f"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0B0813"
    }
  }
}