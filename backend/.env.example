# Supabase Configuration (Backend uses SUPABASE_URL or falls back to EXPO_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend Configuration
PORT=4000
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8081

# App Configuration
EXPO_PUBLIC_APP_NAME=Memora
EXPO_PUBLIC_APP_SCHEME=memora

# Supabase Service Role Key (BACKEND ONLY - NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key